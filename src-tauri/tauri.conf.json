{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vellum",
  "version": "0.1.2",
  "identifier": "io.github.canoemoose.vellum",
  "build": {
    "beforeDevCommand": "node tools/fetch-pdfium.mjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node tools/fetch-pdfium.mjs && node tools/make-notices.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vellum",
        "width": 1400,
        "height": 900,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false,
        "backgroundColor": "#141517",
        "dragDropEnabled": true,
        "zoomHotkeysEnabled": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "pdfium/bin/pdfium.dll": "pdfium.dll",
      "../LICENSE": "LICENSE.txt",
      "licenses/THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "shortDescription": "Fast PDF and image viewer for CAD drawings"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxMERDRkVBRTQ1OENDOTIKUldTU3pGams2czhONGRGOFdMaEN4Q3FsUmZMQWI3aDU1V2Y1VldsRWxuUGVVUlMvVGl6L2gwUWQK",
      "endpoints": [
        "https://github.com/canoemoose/Vellum/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
