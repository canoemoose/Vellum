{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vellum",
  "version": "0.1.0",
  "identifier": "engineering.event.vellum",
  "build": {
    "beforeDevCommand": "node tools/fetch-pdfium.mjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node tools/fetch-pdfium.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vellum",
        "width": 1400,
        "height": 900,
        "minWidth": 640,
        "minHeight": 400,
        "visible": false,
        "backgroundColor": "#141517",
        "dragDropEnabled": true,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "pdfium/bin/pdfium.dll": "pdfium.dll",
      "pdfium/LICENSE": "licenses/PDFIUM-LICENSE.txt"
    }
  }
}
